APP_NAME=Laravel
APP_ENV=production
APP_DEBUG=false
APP_URL=https://rgo.intercrop.co.th
APP_KEY=

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database (Cloud SQL ผ่าน Proxy)
DB_CONNECTION=mysql
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=rgo_db
DB_USERNAME=bank-db
DB_PASSWORD=Bank2012@

# Cache & Queue
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Mail (ใส่ค่าจริงถ้าจะส่งเมล)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@rgo.intercrop.co.th"
MAIL_FROM_NAME="${APP_NAME}"


APP_TIMEZONE=Asia/Bangkok
APP_LOCALE=th


# Other Laravel stuff
